# macOS-specific shell configuration
# Sourced by .zshrc on macOS only

# macOS-only OMZ plugins
plugins+=(brew macos)

# Clipboard
alias copysshkey='pbcopy < ~/.ssh/id_rsa.pub'
alias myip='curl ifconfig.me -v | pbcopy'
alias pubkey='more ~/.ssh/id_rsa.pub | pbcopy | printf "=> Public key copied to pasteboard.\n"'

# Finder
alias hidedotfiles='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'
alias showdotfiles='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias restoreFinderSidebar="cd ~/Library/Preferences && sudo find com.apple.finder.plist* -exec rm {} \; && killall Finder"

# Apps
alias vlc="/Applications/VLC.app/Contents/MacOS/VLC"
alias newtab="open -a iTerm ."
alias nt="open -a iTerm ."

# Misc macOS tools
alias ql='qlmanage -p'
alias pdfjoin="/System/Library/Automator/Combine\ PDF\ Pages.action/Contents/Resources/join.py"
alias emptyioscache='xcrun simctl erase all'

# Tell shells (and any process started from them) about the Ollama models override.
# The launchd-managed Ollama.app gets it via `launchctl setenv` on every `aimodels ollama` flip.
export OLLAMA_MODELS="$HOME/.ollama-models"

# macOS app launchers
# Open in MacDown
macdown() { open -a MacDown $1 }

# Open in Clearly
clearly() { open -a Clearly $1 }

chromewin(){
	open -n -a 'Google Chrome' --args "--app=$1"
}

google-chrome() {
	/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome $1
}

# Loads... nvm.
loadnvm() {
	if [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]
	then
		. "/opt/homebrew/opt/nvm/nvm.sh"
	fi

	if [ -s "/opt/homebrew/opt/nvm/etc/bash_completion" ]
	then
		. "/opt/homebrew/opt/nvm/etc/bash_completion"
	fi

	nvm use ${1-'20'}
}
