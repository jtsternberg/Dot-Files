#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# ollamodels — backward-compatible shim for `aimodels ollama`.
# By Justin Sternberg <me@jtsternberg.com>
#
# Version 1.0.0
#
# Pointing Ollama's store (~/.ollama-models) at local disk or the AI-LAB drive,
# and reconciling local models into the AI-LAB tree, now live in
# `aimodels ollama`, alongside MacWhisper's store and the one LaunchAgent that
# follows the drive for both. Every old invocation is forwarded; -y/--yes is
# accepted and ignored, since reconcile only ever adds symlinks.
#
# `ollama rm` on the AI-LAB store after a reconcile is safe: it unlinks the
# symlinks and leaves the local originals alone (verified; dotfiles-2zh).
#
# Usage:
# ollamodels [local|sd|auto|reconcile] [--dry-run]
#
# Examples:
# ollamodels                       # aimodels ollama auto: AI-LAB if mounted, else local
# ollamodels sd                    # aimodels ollama sd
# ollamodels local                 # aimodels ollama local
# ollamodels reconcile --dry-run   # aimodels ollama reconcile --dry-run
# ollamodels reconcile -y          # aimodels ollama reconcile
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

$forwarded = AiModelsCommand::ollamodelsArgv( $argv );
if ( null === $forwarded ) {
	$cli->err( 'Watcher management moved to `aimodels`, which follows AI-LAB for every model store.' );
	$cli->msg( '  aimodels watch install | remove | status', 'yellow' );
	exit( 1 );
}

$cli->setArgs( $forwarded );

exit( ( new Dispatcher( $cli, new AiModelsCommand( $cli ) ) )->run() );
