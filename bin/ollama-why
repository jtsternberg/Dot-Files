#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# ollama-why — backward-compatible shim for `aimodels why`, scoped to Ollama.
# By Justin Sternberg <me@jtsternberg.com>
#
# Version 1.0.0
#
# Model notes (when/speed/tags/tested/location) and the graveyard of tested-and-
# removed models now live in `aimodels why`, which covers every local engine
# (Ollama and MacWhisper) and reads locations from the same inventory as
# `aimodels status`. Every old invocation still works: it is forwarded as
# `aimodels why <args> --engine=ollama`. Bare model names resolve as Ollama tags,
# and the old `sd` location is accepted as `external`.
#
# Usage:
# ollama-why [list|set|rm|locate|history|forget|notes|path] [<model>] [<text>] [--when=<text>] [--speed=<text>] [--tags=<csv>] [--tested=<text>] [--location=<local|external|both>] [--delete-model] [--json]
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

$cli->setArgs( AiModelsCommand::ollamaWhyArgv( $argv ) );

exit( ( new Dispatcher( $cli, new AiModelsCommand( $cli ) ) )->run() );
