#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# Create a commit from currently staged files using Apple's on-device Foundation Model (`fm`).
# By Justin Sternberg <me@jtsternberg.com>
# https://github.com/jtsternberg/Dot-Files/blob/master/bin/auto-commit-fm
#
# Version 0.1.0
#
# Generates a commit message from staged changes using Apple's on-device Foundation Model,
# then creates the commit automatically.
#
# Usage:
# auto-commit-fm [context] [options]
# auto-commit-fm --help
# auto-commit-fm completion zsh
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

exit( ( new Dispatcher( $cli, new AutoCommitFmCommand( $cli ) ) )->run() );
