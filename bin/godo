#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# godo — "go and do". Run stored commands inside a dirmap-mapped directory.
# By Justin Sternberg <me@jtsternberg.com>
# https://github.com/jtsternberg/Dot-Files/blob/master/bin/godo
#
# Version 0.2.0
#
# The attribute-driven GodoCommand handler is the canonical command contract:
# reflection dispatches its methods and renders both help and Zsh completion.
#
# Usage:
# godo help
# godo <key> [--default=<cmd>]
# godo get <key>
# godo addcmd <key> <command>
# godo setcmd <key> <command>
# godo rmcmd <key> [<command>]
# godo remove <key>
# godo list [--keys|-k] [--json|-j]
# godo edit
# godo completion zsh
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

exit( ( new Dispatcher( $cli, new GodoCommand( $cli ) ) )->run() );
