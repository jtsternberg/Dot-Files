#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# Create a commit from currently staged files using Ollama.
# By Justin Sternberg <me@jtsternberg.com>
# https://github.com/jtsternberg/Dot-Files/blob/master/bin/auto-commit-ollama
#
# Version 0.2.0
#
# Generates a commit message from staged changes using a local Ollama model,
# then creates the commit automatically.
#
# Usage:
# auto-commit-ollama [context] [options]
# auto-commit-ollama --help
# auto-commit-ollama completion zsh
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

exit( ( new Dispatcher( $cli, new AutoCommitOllamaCommand( $cli ) ) )->run() );
