#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# linux-catchup — catch this Linux box up: tools, repos, and system updates.
# By Justin Sternberg <me@jtsternberg.com>
# https://github.com/jtsternberg/Dot-Files/blob/master/bin/linux-catchup
#
# Version 0.1.0
#
# Runs, in order (each toggleable in ~/.linux-catchup.json):
#   1. codex update
#   2. claude update
#   3. ollama: upgrade via the vendor installer when behind the latest release,
#              unless a model is resident (restarting kills in-flight inference)
#   4. repos:  godo <key> for each configured key (defaults to `git prb`)
#   5. system: refresh apt and report upgradable + security + reboot-required.
#              With --apply, runs the upgrade (apt-get upgrade).
#
# --unattended is the timer/cron mode (see linux-catchup/linux-catchup.timer):
# no sudo, no prompts, stdin closed. Repos still run `godo <key>`; a key with
# no godo commands runs the default without the map-seed prompt. The apt
# refresh, --apply, and the ollama installer need sudo, so they are skipped
# and say so. A lock next to the config keeps overlapping runs from colliding.
#
# The attributed LinuxCatchupCommand handler defines dispatch, help, and
# completion while keeping operational dependencies lazy and testable.
#
# Usage:
# linux-catchup [--apply] [--yes|-y] [--only=<steps>] [--unattended]
# linux-catchup --unattended </dev/null   What the systemd timer runs
# linux-catchup --only=system --apply   Only apply system updates
# linux-catchup config          Print the resolved config + its path
# linux-catchup completion zsh
#
# Steps: codex, claude, ollama, repos, system (alias: system-update). --only runs just
# the named step(s), comma-separated, overriding the config toggles.
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

exit( ( new Dispatcher( $cli, new LinuxCatchupCommand( $cli ) ) )->run() );
