#!/usr/bin/env bash
# =============================================================================
# llmsummarize — summarize a file in a few plaintext sentences via one of
# several LLM backends ("forks"), or let it pick automatically by file size.
# By Justin Sternberg <me@jtsternberg.com>
#
# Version 2.0.0
#
# Forks:
#   ollama  — fully local, zero API cost, via local-llm-summarize (model per store
#             from SUMMARY_MODEL_SD / SUMMARY_MODEL_LOCAL in the shared config)
#   claude  — cloud: Claude Code headless (default model haiku, overrideable; lean --safe-mode)
#   agy     — cloud: agy (Antigravity) on gemini-3.6-flash-low
#
# Auto routing (no fork given) is size-based, per benchmarks on this machine:
#   local cold summarization is ~O(input) — a ~35K-token file is ~2 min on any
#   local model — so files up to ~50K tokens stay local, and huge files fall back
#   to the cloud claude fork (default haiku), since local's ~2-min floor defeats
#   the point of "fast". --local keeps a huge file local anyway.
#
# The local fork is local-llm-summarize's text mode: a system role, the
# instruction after the content, temperature 0, think:false, and num_ctx sized
# to the file so long files are NOT silently truncated. See the local-models
# skill for the footguns this encodes.
#
# Usage:
#   llmsummarize <file>                 # auto: pick fork by size
#   llmsummarize auto <file>            # same, explicit
#   llmsummarize ollama <file> [model]  # force local; optional model override
#   llmsummarize claude <file> [model]  # force cloud Claude; optional model (default: haiku)
#   llmsummarize agy <file>             # force cloud agy/gemini
#   llmsummarize -h | --help
#
#   Flags: --local (with auto: never fall back to cloud)
# =============================================================================

set -euo pipefail

# Size tier in bytes (~4 bytes/token for prose).
HUGE_MIN=200000    # >= ~50K tokens -> cloud fallback in auto mode

# Prompt for the cloud forks (they read the file themselves via their own tools).
CLOUD_PROMPT_PREFIX='Can you summarize in a few sentences the contents of this file: '
CLOUD_PROMPT_SUFFIX='. Respond in plaintext only.'

usage() { sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; }

die() { echo "llmsummarize: $*" >&2; exit 1; }

need_file() {
	[ -n "${1:-}" ] || die "missing <file>. See -h."
	[ -f "$1" ] || die "no such file: $1"
}

summarize_ollama() { # $1=file  $2=model(optional)
	need_file "${1:-}"
	local file="$1" model="${2:-}"
	local start=$SECONDS
	local out rc
	out="$(mktemp)"
	# --json so the chosen model can be reported; the summary is the result.
	rc=0
	local-llm-summarize "$file" --json ${model:+"--model=$model"} > "$out" || rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "llmsummarize: $(jq -r '.error // "local-llm-summarize failed"' "$out" 2>/dev/null || cat "$out")" >&2
		rm -f "$out"
		return "$rc"
	fi
	echo "→ ollama $(jq -r '.model' "$out") (~$(( $(wc -c < "$file") / 1024 ))KB)" >&2
	jq -r '.summary' "$out"
	rm -f "$out"
	printf '\nTook %ds\n' $((SECONDS - start))
}

summarize_claude() { # $1=file  $2=model(optional, default haiku)
	need_file "${1:-}"
	local model="${2:-haiku}"
	local start=$SECONDS
	echo "→ claude (cloud, model=$model)" >&2
	claude --print "${CLOUD_PROMPT_PREFIX}${1}${CLOUD_PROMPT_SUFFIX}" \
		--model "$model" --safe-mode --tools Read --dangerously-skip-permissions
	printf '\nTook %ds\n' $((SECONDS - start))
}

summarize_agy() { # $1=file
	need_file "${1:-}"
	local start=$SECONDS
	echo "→ agy (cloud)" >&2
	agy --print "${CLOUD_PROMPT_PREFIX}${1}${CLOUD_PROMPT_SUFFIX}" \
		--print-timeout 15m0s --dangerously-skip-permissions --model gemini-3.6-flash-low
	printf '\nTook %ds\n' $((SECONDS - start))
}

route_auto() { # $1=file  ($2 present => --local)
	need_file "${1:-}"
	local file="$1" local_only="${2:-}"
	local bytes; bytes=$(wc -c < "$file")
	if [ "$bytes" -lt "$HUGE_MIN" ] || [ -n "$local_only" ]; then
		summarize_ollama "$file"
	else
		echo "→ file is ~$((bytes/1024))KB; local would take minutes — using cloud claude/haiku (--local to override)." >&2
		summarize_claude "$file"
	fi
}

cmd="${1:-}"
case "$cmd" in
	-h|--help|"") usage; exit 0 ;;
	ollama)  shift; summarize_ollama "${1:-}" "${2:-}" ;;
	claude)  shift; summarize_claude "${1:-}" "${2:-}" ;;
	agy)     shift; summarize_agy "${1:-}" ;;
	auto)    shift
		if [ "${1:-}" = "--local" ]; then shift; route_auto "${1:-}" local
		else route_auto "${1:-}" "$([ "${2:-}" = "--local" ] && echo local)"; fi ;;
	--local) shift; route_auto "${1:-}" local ;;
	*)  # First arg is (presumably) a file -> auto mode.
		route_auto "$cmd" "$([ "${2:-}" = "--local" ] && echo local)" ;;
esac
