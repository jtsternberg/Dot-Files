#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# Summarize a file, or an archived agent session, with a local Ollama model.
# By Justin Sternberg <me@jtsternberg.com>
#
# Version 0.1.0
#
# Text mode describes the input in 2 to 4 sentences. --session reads a
# graveyard transcript.md and returns a TITLE plus two sentences (the engine
# behind the graveyard page's summarize button). The model resolves per store
# from SUMMARY_MODEL_SD / SUMMARY_MODEL_LOCAL in ~/.config/auto-commit-ollama/config.
#
# Usage:
# local-llm-summarize [<file>] [--session] [--model=<model>] [--json]
# cat notes.txt | local-llm-summarize
# local-llm-summarize --help
# local-llm-summarize completion zsh
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

exit( ( new Dispatcher( $cli, new LocalLlmSummarizeCommand( $cli ) ) )->run() );
