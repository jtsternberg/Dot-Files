#!/usr/bin/env php
<?php
namespace JT;
# =============================================================================
# Backup and restore cmux workspace/session state
# By Justin Sternberg <me@jtsternberg.com>
#
# Version 0.4.0
#
# Saves all cmux workspaces, panes, and surfaces to ~/.config/cmux/bak.json,
# capturing each terminal's CWD and any active Claude Code OR codex session.
#
# Neither agent is screen-scraped. Claude session IDs come from
# ~/.claude/sessions/<pid>.json, bound to a surface by walking process ancestry
# to the resume script that surface launched. Codex has no such script, so its
# sessions come from the rollout jsonl each live codex holds open (lsof) and bind
# to a surface via CMUX_SURFACE_ID, which cmux puts in every surface process's
# environment and reports per surface as the tree's `id`. Both joins are exact
# and tty-free — cmux recycles tty numbers, so a tty is not an identity.
#
# On restore, audits existing workspaces by name and only acts on what's
# missing: resumes dead sessions in existing workspaces (`claude --resume <id>`
# or `codex resume <id>`), and recreates workspaces that are gone entirely.
#
# A recreated workspace gets its recorded pane COUNT back, with each surface
# returned to its own pane. Split orientation and divider ratio are not recorded
# — `cmux tree`, the backup's only source, reports panes as a flat list with no
# geometry — so panes beyond the first come back as right-splits.
#
# A missing workspace whose surfaces hold no agent session at all would restore
# as an empty shell, so restore asks first and skips by default. Recorded cwds
# are checked before use: one that has since been deleted is reported and the cd
# dropped, leaving the shell where it spawned; the agent still resumes.
#
# A codex resume replays the model/sandbox/approval/effort recorded in the
# rollout's last turn_context. That is NOT redundant: measured, `codex resume`
# re-reads ~/.codex/config.toml instead of rehydrating turn_context, so a session
# that ran --sandbox=read-only comes back danger-full-access if resumed bare.
# Passing the recorded values back keeps a restore from widening a sandbox.
#
# `audit` is a read-only diff: it compares the backup's sessions against what's
# actually running now (matched by session id via those joins) and reports which
# conversations did not re-open — then offers to resume the missing ones into
# their existing surfaces.
#
# Backup schema v2 records one generic agent per surface (agent,
# agent_session_id, agent_model, agent_skip_permissions). v1 files, which carried
# claude_* keys, are still readable.
#
# Usage:
# cmux-bak [--file=<path>] [--dry-run] [--verbose]
# cmux-bak restore [--file=<path>] [--dry-run] [--verbose]
# cmux-bak audit [--file=<path>] [--dry-run] [--verbose]
# cmux-bak completion zsh
# =============================================================================

use JT\CLI\Command\Dispatcher;

$cli = require_once dirname( __DIR__ ) . '/src/bootstrap.php';

// Cmux::tree() throws (not exit()s) when cmux is unreachable/unparseable; convert it to
// an exitErr here at the entry seam rather than inside the shelling seam (dotfiles-3qa).
try {
	exit( ( new Dispatcher( $cli, new CmuxBakCommand( $cli ) ) )->run() );
} catch ( \RuntimeException $e ) {
	$cli->exitErr( $e->getMessage() );
}
